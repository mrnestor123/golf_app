{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "outDir": "./src/dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "allowJs": true
  },
  "include": ["src/**/*.ts", "src/components/**/*.js"],
  "exclude": ["node_modules", "dist", "assets"]
}